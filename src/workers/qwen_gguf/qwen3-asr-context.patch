+// Copy the optional public extension while the caller-owned pointer is
+// valid.  The dispatcher has already checked the extension kind and shape;
+// the defensive NULL/empty handling keeps direct family calls harmless.
+transcribe_status copy_run_context(QwenAsrSession *                 session,
+                                    const transcribe_run_params *    params) {
+    session->run_context.clear();
+    if (params == nullptr || params->family == nullptr) {
+        return TRANSCRIBE_OK;
+    }
+    const auto * ext = reinterpret_cast<const transcribe_qwen3_asr_run_ext *>(params->family);
+    if (ext->context != nullptr && ext->context[0] != '\0') {
+        session->run_context.assign(ext->context);
+    }
+    return TRANSCRIBE_OK;
+}
