index 0000000..119cde3
--- /dev/null
+++ b/include/transcribe/qwen3_asr.h
@@ -0,0 +1,41 @@
+/*
+ * include/transcribe/qwen3_asr.h - Qwen3-ASR-family public extension.
+ *
+ * The extension provides a short, caller-owned context string that is
+ * inserted into the model's system turn before an offline run.  It is meant
+ * for correct terminology and domain hints, not for arbitrary generation
+ * instructions.  The library tokenizes and copies the context during the
+ * synchronous transcribe_run call.
+ */
+
+#ifndef TRANSCRIBE_QWEN3_ASR_H
+#define TRANSCRIBE_QWEN3_ASR_H
+
+#include "transcribe.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* 'QASR' little-endian = 0x52534151. */
+#define TRANSCRIBE_EXT_KIND_QWEN3_ASR_RUN 0x52534151u
+
+/*
+ * Qwen3-ASR offline run knobs.
+ *
+ * context is UTF-8 plain text. NULL or an empty string selects the normal
+ * empty system turn. The pointer is borrowed only for the duration of the
+ * transcribe_run call; callers may release it immediately after return.
+ */
+struct transcribe_qwen3_asr_run_ext {
+    struct transcribe_ext ext;
+    const char *           context;
+};
+
+TRANSCRIBE_API void transcribe_qwen3_asr_run_ext_init(struct transcribe_qwen3_asr_run_ext * p);
+
+#ifdef __cplusplus
+} /* extern "C" */
+#endif
+
+#endif /* TRANSCRIBE_QWEN3_ASR_H */
